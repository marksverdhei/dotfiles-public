#!/usr/bin/python3
# omarchy:summary=Cycle the focused workspace wallpaper through its controller
import json, os, subprocess, sys
from pathlib import Path
home = Path.home()
theme = (home/'.config/omarchy/current/theme.name').read_text().strip()
dirs = [home/'.config/omarchy/backgrounds'/theme, home/'.config/omarchy/current/theme/backgrounds']
files = sorted(str(p.resolve()) for d in dirs if d.is_dir() for p in d.iterdir()
               if p.is_file() and p.suffix.lower() in ('.png','.jpg','.jpeg','.webp','.gif','.mp4','.mkv','.webm','.mov'))
if not files:
    sys.exit('No backgrounds available; current wallpaper retained')
try:
    mons = json.loads(subprocess.check_output(['hyprctl','-j','monitors']))
    output = next(m['name'] for m in mons if m.get('focused'))
    state = json.loads(subprocess.check_output(['haios-workspace-scenes','active']))
    entry = state.get('outputs',{}).get(output,{})
    if os.environ.get('HAIOS_WALLPAPER_AUTOCYCLE') == '1' and entry.get('mode') != 'managed':
        sys.exit(0)
    current = entry.get('spec',{}).get('base')
    index = (files.index(current)+1) % len(files) if current in files else 0
    subprocess.run(['haios-workspace-scenes','set-active',files[index],'--output',output],check=True)
except (subprocess.SubprocessError, ValueError, StopIteration) as e:
    sys.exit(str(e))
