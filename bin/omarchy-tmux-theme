#!/bin/bash
# HAIos tmux theme — follows ~/ht/design-system (tokens/tokens.json):
# flat near-black, ONE accent (cyan #22d3ee), tinted "glass" chips with
# rounded caps, status = colour PLUS a word, no emoji icons.
#
# Two colours are resolved:
#   ACCENT  page chrome (borders, active window, session chip). HAIos cyan,
#           unless the ACTIVE THEME carries its own accent
#           (~/.config/hai-os/session-accent.env, SESSION_ACCENT_SOURCE=theme,
#           hai-os #237) — theming is temporary and wins while it lasts.
#   HOST    the machine's identity colour, shown ONLY as the hostname dot.
#           Resolution: ~/dotfiles/private/tmux/colors.json (curated) ->
#           HaiOS fleet accent ~/.config/hai-os/accent.env -> ACCENT.
# Optional $1 = tmux socket path (hai-os theme-set hook applies per server).
T="tmux"
[ -n "${1:-}" ] && T="tmux -S $1"

hex_ok() { case "$1" in \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) return 0 ;; esac; return 1; }

ACCENT="#22d3ee"
if [ -f "$HOME/.config/hai-os/session-accent.env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.config/hai-os/session-accent.env" 2>/dev/null
  [ "${SESSION_ACCENT_SOURCE:-}" = "theme" ] && hex_ok "${SESSION_ACCENT:-}" && ACCENT="$SESSION_ACCENT"
fi

HOST=$(python3 -c "import json,socket,os; f=os.path.expanduser('~/dotfiles/private/tmux/colors.json'); print(json.load(open(f)).get(socket.gethostname(), '') if os.path.exists(f) else '')" 2>/dev/null)
if ! hex_ok "$HOST" && [ -f "$HOME/.config/hai-os/accent.env" ]; then
  # shellcheck disable=SC1091
  HOST="$(. "$HOME/.config/hai-os/accent.env" 2>/dev/null; echo "${HAI_OS_ACCENT:-}")"
fi
hex_ok "$HOST" || HOST="$ACCENT"
HOST=$(python3 - "$HOST" <<'PY2'
import sys
h=sys.argv[1].lstrip('#'); c=[int(h[i:i+2],16) for i in (0,2,4)]
lum=lambda c:(0.2126*c[0]+0.7152*c[1]+0.0722*c[2])/255
while lum(c)<0.42: c=[min(255,round(v+(255-v)*0.12)) for v in c]
print('#%02x%02x%02x'%tuple(c))
PY2
)

# Tokens (tints are cyan-tint / cyan-line composited over the terminal bg,
# because tmux has no alpha). A theme may override the chip fill by shipping
# tmux-status-bg.hex in the active theme dir.
BG="#03070c"      # --bg, used as ink-on-accent
INK="#e6f7fb"     # --ink
INK2="#c9e6ee"    # --ink-2
MUTED="#8fb8c4"   # --muted
FAINT="#6f95a1"   # --faint
CHIP="#0e2633"    # --cyan-tint over bg
LINE="#135464"    # --cyan-line over bg
BAND="default"    # status bar has no fill of its own: the terminal
                  # (and its transparency) shows through
WARN="#fbbf24"    # --warn
BAD="#f87171"     # --bad
if [ -f "$HOME/.config/omarchy/current/theme/tmux-status-bg.hex" ]; then
  seg="$(head -1 "$HOME/.config/omarchy/current/theme/tmux-status-bg.hex" | tr -d '[:space:]')"
  hex_ok "$seg" && CHIP="$seg"
fi
L=$'\ue0b6'  # rounded cap, left
R=$'\ue0b4'  # rounded cap, right
G_HEART=$'\uf004'  # nf-fa-heart
G_MIC=$'\uf130'    # nf-fa-microphone

$T set -gu status-format
$T set -g status-bg default
$T set -g status-style "bg=$BAND,fg=$MUTED"
$T set -g status-justify left
$T set -g status-left-length 60
$T set -g status-right-length 60

# chrome
$T set -g pane-border-lines single
$T set -g pane-border-style "fg=$LINE"
$T set -g pane-active-border-style "fg=$ACCENT"
$T set -g message-style "bg=$CHIP,fg=$INK"
$T set -g message-command-style "bg=$CHIP,fg=$ACCENT"
$T set -g mode-style "bg=$ACCENT,fg=$BG,bold"
$T set -g copy-mode-match-style "bg=$LINE,fg=$INK"
$T set -g copy-mode-current-match-style "bg=$WARN,fg=$BG"
$T set -g menu-style "bg=default,fg=$INK2"
$T set -g menu-selected-style "bg=$ACCENT,fg=$BG,bold"
$T set -g menu-border-style "fg=$ACCENT"
$T set -g menu-border-lines rounded
$T set -g popup-style "bg=default,fg=$INK2"
$T set -g popup-border-style "fg=$ACCENT"
$T set -g popup-border-lines rounded
$T set -g display-panes-colour "$LINE"
$T set -g display-panes-active-colour "$ACCENT"
$T setw -g clock-mode-colour "$ACCENT"
$T set -g display-panes-border-style "fg=$LINE"
$T set -g tree-mode-border-style "fg=$LINE"
$T set -g tree-mode-preview-style "fg=#{?#{||:#{&&:#{pane_format},#{pane_active}},#{&&:#{window_format},#{window_active}}},$ACCENT,$LINE}"
$T set -g pane-scrollbars-style "bg=$CHIP,fg=$ACCENT,width=1,pad=0"
$T set -g copy-mode-mark-style "bg=$WARN,fg=$BG"
$T set -g copy-mode-line-number-style "fg=$LINE"
$T set -g copy-mode-current-line-number-style "fg=$ACCENT"
$T set -g switch-mode-match-style "bg=$ACCENT,fg=$BG"
# tmux 3.8 defaults: underscore on current, reverse on bell/activity — the
# formats below own all of that, so neutralise the built-in styles.
$T setw -g window-status-style default
$T setw -g window-status-current-style default
$T setw -g window-status-last-style default
$T setw -g window-status-activity-style default
$T setw -g window-status-bell-style default
$T set -g session-status-current-style "fg=$ACCENT,bold"
$T set -g pane-status-current-style "fg=$ACCENT,bold"

# Left: session chip (cyan; amber + word while the prefix is held, so the
# state is never colour alone) and the active pane id on a glass chip.
STATE="#{?client_prefix,$WARN,$ACCENT}"
$T set -g status-left "#[fg=$STATE,bg=$BAND]$L#[fg=$BG,bg=$STATE,bold]#{?client_prefix,PREFIX ,}#S#[fg=$STATE,bg=$CHIP,nobold]$R#[fg=$MUTED,bg=$CHIP] #{pane_id}#[fg=$CHIP,bg=$BAND]$R  "

# Right: tmux-continuum's save hook must stay first — status refresh is what
# fires periodic saves. Then the hostname, with the host identity dot.
CONTINUUM_HOOK=""
if [ -x "$HOME/.config/tmux/plugins/tmux-continuum/scripts/continuum_save.sh" ]; then
  CONTINUUM_HOOK="#($HOME/.config/tmux/plugins/tmux-continuum/scripts/continuum_save.sh)"
fi
$T set -g status-right "${CONTINUUM_HOOK}#[fg=$CHIP,bg=$BAND]$L#[fg=$HOST,bg=$CHIP]● #[fg=$INK,bg=$CHIP]#h#[fg=$CHIP,bg=$BAND]$R"

# Windows — the same two-tone pill as the session: a solid index cell, then
# a glass body with pane id, name, and the running command when it differs.
# Inactive windows are the same shape drawn quietly, no fill; under 120
# columns they drop their pane id so the list doesn't truncate.
DOT="#[fg=$LINE] · "
$T set -g window-status-separator " "
$T set -g window-status-format "#[fg=$FAINT,bg=$BAND] #I #{?#{e|<:#{client_width},120},,#[fg=$LINE]#{pane_id} }#[fg=$MUTED]#W#{?window_bell_flag,#[fg=$BAD#,bold] bell#[nobold],}#{?window_zoomed_flag,#[fg=$FAINT] zoom,} "
$T set -g window-status-current-format "#[fg=$ACCENT,bg=$BAND]$L#[fg=$BG,bg=$ACCENT,bold]#I#[fg=$ACCENT,bg=$CHIP,nobold]$R#[fg=$MUTED] #{pane_id} #[fg=$INK,bold]#W#[nobold]#{?#{==:#W,#{pane_current_command}},,$DOT#[fg=$MUTED]#{=12:pane_current_command}}#{?window_zoomed_flag,$DOT#[fg=$ACCENT]zoom,}#[fg=$CHIP,bg=$BAND]$R"

# Pane header (top border label).
# Talking-stick holder (its id == /tmp/talking-stick-holder): the whole label
# turns amber with a mic glyph and the word STICK. A live heartbeat adds a red
# heart glyph. Numeric ids are compared (tmux reads a literal `%37` as a width
# directive), hence #{s/^%//:pane_id} and `tr -d "%\n"`. The heartbeat match
# uses ` %5 %7 ` spacing so %5 never bleeds into %50. Refreshes every
# status-interval (~2s), so the label follows a stick transfer.
if [ "$($T show-options -gwv pane-border-status 2>/dev/null)" = "top" ]; then
  NAME="#{?#{!=:#{pane_title},#{host}},#{pane_title},#{pane_current_command}}"
  HEART="#{?#{m:* #{pane_id} *,#(cat /tmp/heartbeat-active-panes 2>/dev/null)},#[fg=$BAD]$G_HEART ,}"
  STICK="#{==:#{s/^%//:pane_id},#(cat /tmp/talking-stick-holder 2>/dev/null | tr -d '%\\n')}"
  # heartbeat drawn dark on amber so it survives inside the holder pill
  HEART_ON_STICK="#{?#{m:* #{pane_id} *,#(cat /tmp/heartbeat-active-panes 2>/dev/null)},$G_HEART ,}"
  # holder: one solid amber pill — mic, the word STICK, heartbeat, id, name
  P_STICK="#[fg=$WARN]$L#[bg=$WARN#,fg=$BG#,bold]$G_MIC STICK  $HEART_ON_STICK#{pane_id}  $NAME#[bg=default#,fg=$WARN#,nobold]$R"
  # active: two-tone pill like the active window (solid id, glass title)
  P_ACTIVE="#[fg=$ACCENT]$L#[bg=$ACCENT#,fg=$BG#,bold]#{pane_id}#[bg=$CHIP#,fg=$ACCENT#,nobold]$R $HEART#[fg=$INK]$NAME#[bg=default#,fg=$CHIP]$R"
  # inactive: same shape, no fill
  P_IDLE="#[fg=$FAINT] #{pane_id} $HEART#[fg=$MUTED]$NAME "
  $T set -g pane-border-format "#{?$STICK,$P_STICK,#{?pane_active,$P_ACTIVE,$P_IDLE}}#[default]"
fi
